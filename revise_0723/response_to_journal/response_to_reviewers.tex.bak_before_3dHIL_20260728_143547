\begin{algorithm}[H]
\caption{Distributed Consensus-Based IDBO for Cooperative Target Assignment (per interceptor $u_i$)}
\begin{algorithmic}[1]
\REQUIRE Interceptor set $\mathcal{U}$, target set $\mathcal{T}$, probability matrix $\mathbf{P}$~(8), neighbors $\mathcal{N}_i$, capacity $L_{\max}$, IDBO iterations $T$, population size $N_{\mathrm{pop}}$, threshold $\epsilon$
\ENSURE Converged assignment $\mathbf{X}^\ast$
\STATE Initialize preference population $\{\mathbf{x}_i\}$, winner lists $\mathcal{Z}_j\!\leftarrow\!\emptyset$, timestamps $\mathbf{y}_i$, iteration $k\!\leftarrow\!0$
\REPEAT
  \STATE {\itshape // Phase 1: local metaheuristic optimization}
  \FOR{$t=1$ to $T$}
    \STATE Set decaying coefficients $c_t=c_0(1-t/T)$ for $\{\alpha,\beta,\gamma,\delta,\delta',\eta,\sigma_d\}$
    \STATE Evaluate fitness $\mathcal{F}_i$~(13) and advantage $\mathbf{A}_i$~(15)
    \STATE Update $\mathbf{x}_i$ by Rolling/Dancing/Breeding/Stealing~(16)--(19)
  \ENDFOR
  \STATE Binarize preferences by advantage-adaptive thresholding~(20)
  \STATE {\itshape // Phase 2: auction-based distributed consensus}
  \STATE Compute bids $c_{ij}$~(21)
  \STATE Exchange winner lists with $\mathcal{N}_i$; update top-$L_{\max}$ set $\mathcal{Z}_j$~(22)
  \STATE {\itshape // Phase 3: adversarial-information update}
  \STATE Refresh advantages $\mathbf{A}_i^{(k+1)}$ from the consensus assignment
  \STATE Compute swarm disagreement $\Gamma^{(k)}$~(26);\; $k\!\leftarrow\!k+1$
\UNTIL{$\Gamma^{(k)}<\epsilon$}
\STATE \textbf{return} consensus assignment $\mathbf{X}^\ast$
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[H]
\caption{ART-MAPPO Training for Cooperative Swarm Interception (CTDE)}
\begin{algorithmic}[1]
\REQUIRE Actor/critic params $\theta,\phi$; clip $\epsilon$, dual-clip floor $c$; target KL $\delta_{\mathrm{targ}}$; rates $\alpha_T,\rho,\tau_T$; epochs $K$
\ENSURE Trained decentralized policy $\pi_{\theta}$
\STATE Initialize $\theta,\phi$, trust $\mathcal{T}_i\!\leftarrow\!0.5$, KL weight $\beta_{\mathrm{KL}}$, running stats $\mu_R,\sigma_R^2$
\FOR{episode $k=1$ to $K$}
  \STATE {\itshape // Decentralized rollout collection}
  \FOR{each step $t$ and interceptor $i$}
    \STATE Encode $\mathbf{o}_i^{(t)}$; attention--residual features~(28)--(31), temporal state $\mathbf{c}_t$~(36)
    \STATE Form policy $\pi_{\theta_i}$~(37); sample action via trust-blended policy~(43), (44) with $\beta(\mathcal{T}_i)=1-\mathcal{T}_i$
    \STATE Clip $a_i$ to envelope $\mathcal{A}$; step environment; store transition
  \ENDFOR
  \STATE {\itshape // Trust update from episode returns}
  \STATE Update $\mu_R,\sigma_R^2$~(39), (40); normalize $\tilde{R}_i^{(k)}$~(41)
  \STATE Smooth trust $\mathcal{T}_i^{(k+1)}$~(42)
  \STATE {\itshape // Centralized optimization (shared critic on global state~(38))}
  \STATE Compute advantages $\hat{A}_t$ and value targets via GAE~(46), (47)
  \FOR{each mini-batch epoch}
    \STATE Evaluate dual-clip surrogate $J^{\mathrm{DC}}(\theta)$~(48), (49)
    \STATE Estimate $\hat{D}_{\mathrm{KL}}$~(51); value loss $L_V(\phi)$~(53)
    \STATE Minimize total loss $\mathcal{L}(\theta,\phi)$~(54) with AdamW (cosine LR)
  \ENDFOR
  \STATE Adapt KL weight $\beta_{\mathrm{KL}}^{(k+1)}$~(52)
\ENDFOR
\STATE \textbf{return} decentralized policy $\pi_{\theta}$
\end{algorithmic}
\end{algorithm}

